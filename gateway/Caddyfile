# Caddy configuration for NIAC Live Gateway
{
  admin off
}

{$GATEWAY_DOMAIN:localhost} {
  encode zstd gzip

  # Gateway Health Check
  handle /gateway/health {
    reverse_proxy gateway:3000
  }

  # SSE responses are flushed immediately based on their content type.
  # Keep the normal proxy cancellation behavior so disconnected clients close upstream streams.
  handle /gateway/stream {
    reverse_proxy gateway:3000
  }

  # Answer Ingress & Gateway API
  handle /gateway/* {
    reverse_proxy gateway:3000
  }

  # Root health-safe response
  handle {
    respond "NIAC Live Gateway Proxy Active" 200
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
